<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.65.0" />
    <PackageReference Include="Grpc.Tools" Version="2.65.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MassTransit" Version="8.4.0" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Transports\Grpc\Protos\authentication_execution.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atrox.Vectra.Authentication.Api.Application.Contracts\Atrox.Vectra.Authentication.Api.Application.Contracts.csproj" />
    <ProjectReference Include="..\Atrox.Vectra.Authentication.Api.Application\Atrox.Vectra.Authentication.Api.Application.csproj" />
    <ProjectReference Include="..\Atrox.Vectra.Authentication.Api.CrossCutting\Atrox.Vectra.Authentication.Api.CrossCutting.csproj" />
    <ProjectReference Include="..\Atrox.Vectra.Authentication.Api.DataAccess\Atrox.Vectra.Authentication.Api.DataAccess.csproj" />
  </ItemGroup>

</Project>
